# CampusPulse Environment Configuration Template
PROJECT_NAME=CampusPulse
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./campuspulse.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://campus_user:campus_password@localhost:5432/campuspulse_db

DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50

# Security Secrets
JWT_SECRET=campuspulse-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingestion SLAs and Guards
MAX_BATCH_SIZE=1000
MAX_FUTURE_SKEW_SECONDS=600
MAX_PAST_SKEW_SECONDS=604800

# Background Worker
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_BATCH_SIZE=100
JOB_LOCK_TIMEOUT_SECONDS=30
